# ==============================================================================
# Gitea GitHub Mirror v2.2 - Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in your values.
# ==============================================================================

# --- Required ---

# Your Gitea instance base URL (no trailing slash)
GITEA_URL=https://git.example.com

# Gitea personal access token (Settings -> Applications -> Generate Token)
GITEA_TOKEN=your_gitea_token_here

# The Gitea username who will own the mirrored repositories
GITEA_USER=your_gitea_username

# GitHub personal access token (with `repo` scope for private repos)
# Generate at: https://github.com/settings/tokens
# If not set, the script will prompt interactively.
GITHUB_TOKEN=your_github_token_here

# Your GitHub username (used to identify owner repos vs org/collab repos)
GITHUB_USER=your_github_username

# --- Optional ---

# Mirror synchronization interval (Gitea cron format, e.g., '8h0m0s')
# Leave empty to use Gitea server default.
# MIRROR_INTERVAL=8h0m0s

# Unlock full metadata migration (issues, wiki, labels, releases, milestones)
# Immediately trigger a pull sync for existing repositories
SYNC_NOW=true

# Force delete and re-migrate existing repositories (Use with caution!)
FORCE_RECREATE=false


# MIRROR_EXTRAS=true

# Preserve GitHub organization structure (creates matching organizations in Gitea)
# PRESERVE_ORGS=true

# Maximum retry attempts for each failed repo migration (default: 3)
# MAX_RETRIES=3

# Enable Git LFS when creating mirrors (true/false)
# MIRROR_LFS=false

# Comma-separated list of repository names to strictly ignore
# SKIP_REPOS=repo1,repo2

# Webhook URL for notifications (Slack/Discord/Teams/Feishu/DingTalk/Telegram/etc)
# NOTIFY_WEBHOOK=

# Webhook type override: slack|discord|teams|feishu|dingtalk|telegram|generic
# NOTIFY_TYPE=

# Telegram chat_id (required when using Telegram webhook)
# NOTIFY_CHAT_ID=

# Send notification only if failures occur (true/false)
# NOTIFY_ONLY_ON_FAILURE=false

# Include report content in notification (true/false)
# NOTIFY_INCLUDE_REPORT=false

# Number of concurrent worker threads (default: 5)
# Each worker independently waits for Gitea to return HTTP 201.
# Increase for faster throughput; decrease if your server is resource-limited.
# MAX_WORKERS=5

# HTTP request timeout per migration in seconds (default: 600)
# Must be long enough for Gitea to fully clone the largest repo.
# If behind Nginx, also increase proxy_read_timeout to match.
# REQUEST_TIMEOUT=600

# Max retry attempts for transient errors like 5xx (default: 3)
# MAX_RETRIES=3

# Initial retry delay in seconds; doubles each attempt (default: 10)
# RETRY_DELAY=10

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# Max archived report files to keep (default: 50)
# REPORT_MAX_COUNT=50

# UI language: 'en' for English, 'cn' for 简体中文 (default: en)
# LANG_MIRROR=en

# ==============================================================================
# Encrypted mirroring (encrypted_mirror.py) — Gitea <-> GitHub with encryption
# ==============================================================================
# Push:  Gitea -> GitHub — every repo is bundled (git bundle --all) and
#        AES-256-GCM encrypted before pushing. The GitHub repo only ever holds
#        the opaque <repo>.bundle.enc blob + a plaintext marker + README.
# Pull:  GitHub -> Gitea — encrypted mirrors (detected via the
#        .gitea-encrypted-mirror marker) are decrypted and pushed to Gitea.
# Requires: pip install -r requirements-encrypted.txt

# Passphrase used to encrypt/decrypt bundles. This IS the key to your backups:
# store it in a password manager, never commit it. If unset and a TTY is
# available, the script prompts for it interactively.
# ENCRYPTION_PASSPHRASE=your-strong-passphrase-here

# Create GitHub mirror repos as private (default: true). Keep this true —
# defense in depth on top of the encryption.
# GITHUB_MIRROR_PRIVATE=true
